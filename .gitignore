# Doom/mods binaries, runtime and launchers: generated, and far too big for git.
runtime/
iwads/
mods/
launchers/

# Build outputs
pack-manifest.json
PLAY DOOMNITE.cmd
dryrun.log
menu-dryrun.log
vs_out.txt
vs_err.txt
srv.log

# Playnite export, contains local paths
playnite-data/

__pycache__/
*.pyc

# R2 upload transcript: machine-specific paths, and nothing here
# belongs in the repo. The manifests it is derived from are committed.
upload.log

# Secrets. Nothing in this repo needs one -- the R2 credentials live outside it,
# on the Desktop -- but a stray .env committed by habit would leak a live API
# key, and git history keeps it forever after a delete. Ignore the whole
# family so a .env.local or .env.production cannot slip through either.
.env
.env.*
!.env.example

# Credential files, same reasoning. The R2 secrets file is "R2 secrets.txt" on
# the Desktop; if one is ever copied into the pack, do not commit it.
*secrets*.txt
*credentials*.txt

# Electron build output and toolchain. node_modules is 284 packages and release/
# is ~200 MB of installer -- none of it belongs in git.
desktop/node_modules/
desktop/release/
# Staged embeddable Python runtime and its source zip. prepare-python.js
# downloads and hash-checks these at build time, so committing a copy would
# mean shipping an unreviewed binary and ~11 MB for nothing.
desktop/build/python/
desktop/build/python-embed.zip
desktop/build/pack/
