}
.cfg-row .cfg {
  flex: 1 1 auto;
  min-width: 0;
}
.cfg-go {
  flex: none;
  align-self: stretch;
  width: 30px;
  display: grid;
  place-items: center;
  background: transparent;
  color: var(--fg-dim);
  border: 1px solid var(--line-2);
  border-radius: 3px;
  cursor: pointer;
  transition:
    color var(--fast) var(--ease),
    border-color var(--fast) var(--ease),
    background var(--fast) var(--ease);
}
.cfg-go:hover:not(:disabled) {
  color: var(--ember);
  border-color: var(--ember);
  background: color-mix(in srgb, var(--ember) 10%, transparent);
}
.cfg-go:disabled {
  opacity: 0.32;
  cursor: not-allowed;
}
.cfg-go.is-primary {
  color: var(--ember);
  border-color: color-mix(in srgb, var(--ember) 45%, var(--line-2));
}
